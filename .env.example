# ===== YetkazGo bot — muhit o'zgaruvchilari namunasi =====
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring.

# @BotFather bergan bot tokeni (SIZ qo'yasiz)
BOT_TOKEN=123456789:AA-bu-yerga-BotFather-bergan-tokenni-qoying

# Backend API manzili.
#  - Lokal:   http://localhost:5050/api
#  - Render:  https://<backend-nomi>.onrender.com/api   (localhost EMAS!)
API_BASE=http://localhost:5050/api

# PORT — Render web service uni AVTOMATIK beradi (qo'lда qo'ymang).
# Lokalда qo'yilmasa health server ochilmaydi, bot oddiy polling qiladi.

# ===== Mini sayt (Telegram Mini App) =====
# Telegram FAQAT https:// ni qabul qiladi — http://localhost ISHLAMAYDI!
# Sinash uchun tunnel oching (backend 5050 da ishlab turgan holda):
#   cloudflared tunnel --url http://localhost:5050
# U bergan manzilga `/tg-app.html` qo'shib shu yerga yozing, masalan:
#   WEBAPP_URL=https://abcd-1234.trycloudflare.com/tg-app.html
# Bo'sh qoldirilsa — mini sayt o'chadi va bot eski tugmali oqimda ishlaydi.
WEBAPP_URL=

# Buyurtma holatini tekshirish oralig'i (ms) — ixtiyoriy, standart 10000
POLL_MS=10000
